    "@fontsource/nunito": "5.3.0",
    "@fontsource/nunito-sans": "5.3.0",
    "@fontsource/quicksand": "5.3.0",
    "@hugeicons/core-free-icons": "4.3.5",
    "@hugeicons/react": "1.1.10",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "gifenc": "1.0.3",
