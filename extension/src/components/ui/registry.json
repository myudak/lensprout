  "localChanges": {
    "all": "Fetched by scripts/shadcn-add.mjs: icon placeholders → Hugeicons, imports → @/src paths; then Prettier.",
    "slider": "thumbLabel prop (aria-label on thumbs); one thumb for a single number value; root w-full (overridable) instead of data-horizontal:w-full; largeStep = range/10.",
    "spinner": "props spread cast for HugeiconsIcon typing.",
    "sonner": "useTheme from src/ui/theme instead of next-themes.",
    "animated-theme-toggler": "lucide Sun/Moon → Hugeicons (src/components/app/icons); cn path; plain switch when prefers-reduced-motion; registry css (view-transition root) added to globals.css. Used controlled by ThemeProvider. onClick is composed (props spread first) so a Tooltip trigger cannot replace the toggle handler; the button comes from event.currentTarget instead of an internal ref, so a wrapper's ref (React 19 ref-as-prop) passes through untouched (an earlier merged inline ref re-attached every render and hung the page)."
  }
