---
// Webcam and mic: a camera bubble (starring the mascot) and a live waveform.
import { Mascot } from '../../brand/brand';
const bars = [0.4, 0.8, 0.55, 1, 0.7, 0.45, 0.9, 0.6, 0.35];
---

<div class="demo stage" aria-hidden="true">
  <div class="page">
    <span class="line"></span>
    <span class="line short"></span>
    <span class="line"></span>
  </div>
  <div class="bubble"><Mascot className="face" /></div>
  <div class="mic">
    {bars.map((h, i) => <span style={`--h:${h};--i:${i}`}></span>)}
  </div>
</div>

<style>
  .stage {
    position: relative;
    height: 11rem;
    border-radius: 1.25rem;
    background: var(--tile-apricot);
    overflow: hidden;
  }
  .page {
    position: absolute;
    inset: 1rem 1rem 3.4rem;
    background: var(--card);
    border-radius: 0.9rem;
    padding: 0.9rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .line {
    height: 0.5rem;
    border-radius: 999px;
    background: var(--border);
    width: 70%;
  }
  .line.short {
    width: 45%;
  }
  .bubble {
    position: absolute;
    right: 1.2rem;
    bottom: 1.6rem;
    width: 4.6rem;
    height: 4.6rem;
    border-radius: 50%;
    background: #f8dccd;
    border: 3px solid var(--card);
    box-shadow: 0 0 0 2px var(--outline);
    display: grid;
    place-items: center;
    overflow: hidden;
    animation: w-bubble 5s ease-in-out infinite;
  }
  .bubble :global(.face) {
    width: 3.4rem;
    height: 3.4rem;
    margin-top: 0.6rem;
  }
  .mic {
    position: absolute;
    left: 1rem;
    bottom: 0.8rem;
    display: flex;
    align-items: center;
    gap: 3px;
    height: 1.8rem;
    padding: 0 0.7rem;
    border-radius: 999px;
    background: var(--card);
  }
  .mic span {
    width: 4px;
    height: 1.2rem;
    border-radius: 2px;
    background: var(--primary);
    transform: scaleY(var(--h));
    animation: w-wave 0.9s ease-in-out infinite alternate;
    animation-delay: calc(var(--i) * -0.13s);
  }
  @keyframes w-wave {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(var(--h));
    }
  }
  @keyframes w-bubble {
    0%,
    100% {
      transform: translate(0, 0);
    }
    40% {
      transform: translate(-4.5rem, -0.2rem);
    }
    60% {
      transform: translate(-4.5rem, -0.2rem);
    }
  }
</style>
