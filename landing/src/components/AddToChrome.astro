---
import { HugeiconsIcon } from '@hugeicons/react';
import { ChromeIcon } from '@hugeicons/core-free-icons';
import { CHROME_STORE_URL } from '../site';

interface Props {
  size?: 'lg' | 'md';
  label?: string;
}
const { size = 'lg', label = 'Add to Chrome' } = Astro.props;
---

<a
  href={CHROME_STORE_URL}
  class:list={[
    'bg-primary text-primary-foreground hover:bg-primary-hover sticker inline-flex items-center justify-center gap-2.5 rounded-full font-extrabold transition-transform hover:-translate-y-0.5 active:translate-y-0.5',
    size === 'lg' ? 'px-7 py-3.5 text-lg' : 'px-5 py-2.5 text-base',
  ]}
>
  <HugeiconsIcon icon={ChromeIcon} size={size === 'lg' ? 22 : 18} strokeWidth={2} />
  {label}
</a>
