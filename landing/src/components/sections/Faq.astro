---
import { HugeiconsIcon } from '@hugeicons/react';
import { Add01Icon } from '@hugeicons/core-free-icons';
import SectionHeading from '../SectionHeading.astro';
import { FAQ } from '../../content';
---

<section id="faq" aria-labelledby="faq-title" class="mx-auto max-w-3xl px-4 py-20 sm:px-6 sm:py-24">
  <SectionHeading id="faq-title" eyebrow="FAQ">Questions, answered</SectionHeading>
  <div class="space-y-4">
    {
      FAQ.map((f, i) => (
        <details class="bg-card sticker-sm group rounded-2xl" data-reveal style={`--i:${i % 3}`}>
          <summary class="flex cursor-pointer items-center justify-between gap-4 rounded-2xl px-5 py-4 text-left text-lg font-bold">
            {f.q}
            <span
              aria-hidden="true"
              class="faq-plus bg-accent text-accent-foreground grid size-8 shrink-0 place-items-center rounded-full transition-transform"
            >
              <HugeiconsIcon icon={Add01Icon} size={18} strokeWidth={2.5} />
            </span>
          </summary>
          <p class="text-muted-foreground px-5 pb-5 leading-relaxed">{f.a}</p>
        </details>
      ))
    }
  </div>
</section>
