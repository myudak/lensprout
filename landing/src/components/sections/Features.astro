---
import SectionHeading from '../SectionHeading.astro';
import { FEATURES, type Demo } from '../../content';
import ZoomDemo from '../demos/ZoomDemo.astro';
import LocalDemo from '../demos/LocalDemo.astro';
import StageDemo from '../demos/StageDemo.astro';
import WebcamDemo from '../demos/WebcamDemo.astro';
import CursorDemo from '../demos/CursorDemo.astro';
import TrimDemo from '../demos/TrimDemo.astro';
import ExportDemo from '../demos/ExportDemo.astro';
import PresetsDemo from '../demos/PresetsDemo.astro';
import VerticalDemo from '../demos/VerticalDemo.astro';

const DEMOS: Record<Demo, typeof ZoomDemo> = {
  zoom: ZoomDemo,
  local: LocalDemo,
  stage: StageDemo,
  webcam: WebcamDemo,
  cursor: CursorDemo,
  trim: TrimDemo,
  export: ExportDemo,
  presets: PresetsDemo,
  vertical: VerticalDemo,
};
// Wide cards in the bento grid (two columns on md and lg).
const WIDE = new Set<Demo>(['zoom', 'trim', 'vertical']);
---

<section
  id="features"
  aria-labelledby="features-title"
  class="mx-auto max-w-6xl px-4 py-20 sm:px-6 sm:py-24"
>
  <SectionHeading
    id="features-title"
    eyebrow="Features"
    lead="Record once. Lensprout handles the camera work, then hands you the controls."
  >
    Everything a good demo needs, <span class="text-primary">nothing it doesn’t</span>
  </SectionHeading>
  <ul class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
    {
      FEATURES.map((f, i) => {
        const DemoView = DEMOS[f.demo];
        return (
          <li
            data-reveal
            style={`--i:${i % 3}`}
            class:list={[
              'bg-card sticker flex flex-col gap-5 rounded-3xl p-5 transition-transform hover:-translate-y-1 sm:p-6',
              WIDE.has(f.demo) && 'md:col-span-2',
            ]}
          >
            <div>
              <h3 class="text-xl font-semibold">{f.title}</h3>
              <p class="text-muted-foreground mt-1.5 leading-relaxed">{f.body}</p>
            </div>
            <div class="mt-auto">
              <DemoView />
            </div>
          </li>
        );
      })
    }
  </ul>
</section>
