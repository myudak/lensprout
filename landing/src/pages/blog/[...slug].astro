---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import AnimatedMascot from '../../components/AnimatedMascot';
import AddToChrome from '../../components/AddToChrome.astro';
import PostCard from '../../components/PostCard.astro';
import { formatDate, readingMinutes } from '../../lib/posts';
import { SITE_URL } from '../../site';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}

interface Props {
  post: CollectionEntry<'blog'>;
  posts: CollectionEntry<'blog'>[];
}
const { post, posts } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = `${SITE_URL}/blog/${post.id}/`;
const byId = new Map(posts.map((p) => [p.id, p]));
const related = [
  ...d.related.map((id) => byId.get(id)).filter((p) => p !== undefined),
  ...posts.filter((p) => p.id !== post.id && p.data.kind === d.kind && !d.related.includes(p.id)),
].slice(0, 2);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    mainEntityOfPage: url,
    author: { '@type': 'Organization', name: 'Lensprout' },
    publisher: { '@type': 'Organization', name: 'Lensprout' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL + '/' },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: SITE_URL + '/blog/' },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];
---

<Base title={`${d.title} | Lensprout`} description={d.description} jsonLd={jsonLd} ogType="article">
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6">
    <nav aria-label="Breadcrumb" class="text-muted-foreground text-sm font-bold">
      <ol class="flex flex-wrap gap-1.5">
        <li><a href="/" class="hover:text-primary underline-offset-4 hover:underline">Home</a> /</li>
        <li>
          <a href="/blog/" class="hover:text-primary underline-offset-4 hover:underline">Blog</a> /
        </li>
        <li aria-current="page" class="text-foreground">
          {d.kind === 'comparison' ? 'Comparison' : 'Guide'}
        </li>
      </ol>
    </nav>
    <header class="mt-5">
      <h1 class="text-4xl leading-tight font-semibold tracking-tight sm:text-5xl">{d.title}</h1>
      <p class="text-muted-foreground mt-4 text-xl leading-relaxed">{d.description}</p>
      <p class="text-muted-foreground mt-4 flex flex-wrap gap-x-3 gap-y-1 text-sm font-bold">
        <span>Published <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time></span>
        {
          d.updatedDate && (
            <span>
              · Updated <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time>
            </span>
          )
        }
        <span>· {readingMinutes(post.body ?? '')} min read</span>
      </p>
      {
        d.checkedOn && (
          <p class="bg-tile-apricot text-foreground mt-5 rounded-2xl px-4 py-3 text-sm">
            <strong>Facts checked on {formatDate(d.checkedOn)}.</strong> Other products change their
            features and prices often, so check their sites (linked under Sources) before you
            decide. Spotted something out of date? Tell us and we will fix it.
          </p>
        )
      }
    </header>

    <div class="prose mt-10">
      <Content />
    </div>

    {
      d.sources.length > 0 && (
        <section aria-labelledby="sources" class="border-border mt-12 border-t-2 border-dashed pt-8">
          <h2 id="sources" class="text-2xl font-semibold">
            Sources
          </h2>
          <ul class="text-muted-foreground mt-3 list-disc space-y-1 pl-6">
            {d.sources.map((s) => (
              <li>
                <a
                  href={s.url}
                  rel="noopener nofollow"
                  class="text-accent-foreground font-bold underline underline-offset-2"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <aside
      aria-label="Try Lensprout"
      class="bg-accent sticker mt-12 flex flex-col items-center gap-5 rounded-3xl p-6 text-center sm:flex-row sm:text-left"
    >
      <div class="w-24 shrink-0">
        <AnimatedMascot
          client:visible
          interactive
          className="w-full"
          behaviors={['blink', 'look', 'sway', 'droplets', 'jumpOnVisible']}
        />
      </div>
      <div class="flex-1">
        <p class="font-heading text-2xl font-semibold">Try Lensprout</p>
        <p class="text-foreground mt-1">
          Free, open source, and everything stays on your device. Coming soon to the Chrome Web
          Store.
        </p>
      </div>
      <AddToChrome size="md" />
    </aside>
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="related" class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
        <h2 id="related" class="mb-6 text-3xl font-semibold">
          Keep reading
        </h2>
        <ul class="grid gap-6 md:grid-cols-2">
          {related.map((p, i) => (
            <PostCard post={p} index={i} />
          ))}
        </ul>
      </section>
    )
  }
</Base>
